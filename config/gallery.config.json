{
  "theme": {
    "colors": {
      "paper": "#eff1f3",
      "ink": "#0c0e10",
      "inkSoft": "#1b1f24",
      "inkMute": "rgba(12, 14, 16, 0.66)",
      "red": "#c8102e",
      "redBright": "#e8334e"
    },
    "layout": {
      "measure": "65ch",
      "posterWidth": "42rem",
      "edgeStepMix": 0.12,
      "pad": "clamp(16px, 4vw, 56px)",
      "scrollOffset": "6.5rem"
    },
    "hero": {
      "display": "red",
      "body": "inkSoft",
      "muted": "inkMute"
    },
    "typography": {
      "bodySize": "17px",
      "bodyLineHeight": "1.5",
      "proseLineHeight": "1.6",
      "titleLineHeight": "1.12",
      "titleHeadingLineHeight": "0.95",
      "titleFaceLetterSpacing": "0.02em",
      "labelSize": "0.75rem",
      "labelWeight": "500",
      "labelLetterSpacing": "0.06em",
      "proseSize": "18px",
      "crumbSize": "0.85rem"
    },
    "motion": {
      "cardHoverEase": "cubic-bezier(0.22, 1, 0.36, 1)",
      "cardHoverDuration": "0.4s",
      "revealDuration": "0.8s",
      "revealEase": "ease",
      "shutterDuration": "0.9s",
      "shutterEase": "cubic-bezier(0.77, 0, 0.18, 1)"
    },
    "grain": {
      "opacity": 0.55,
      "opacityOnDarkGrounds": 0.45,
      "tileSize": "96px"
    },
    "code": {
      "text": "paper",
      "blockSteps": 2,
      "blockStepMix": 0.36,
      "referenceSteps": 1,
      "autoCompensateMix": false,
      "inlineSurfaceMix": "35%"
    }
  },
  "darkTheme": {
    "paper": "#12151a",
    "colors": {
      "ink": "#eef0f4",
      "inkSoft": "#c8cdd6",
      "inkMute": "#c0c8d4",
      "red": "#ffa0ab",
      "redBright": "#ffb3bc"
    },
    "dropZone": {
      "butterMix": "22%"
    }
  },
